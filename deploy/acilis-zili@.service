# Açılış Zili — Next.js üretim sunucusu, MAVİ-YEŞİL ŞABLON BİRİMİ (11 Kasım)
#
# Örnek adı port: `acilis-zili@3000` ve `acilis-zili@3001`. Her an YALNIZ
# BİRİ çalışır; deploy sırasında birkaç saniye ikisi birden (update.sh →
# "MAVİ-YEŞİL"). Caddy iki adresi de biliyor ve kapalı olanı atlıyor
# (deploy/Caddyfile → `lb_policy first`). Hangisinin canlı olduğu
# /srv/acilis-zili/shared/active-port dosyasında; cron betikleri ve
# eşitleme betikleri oradan okur.
#
# NEDEN (sahibinin sorusu, 11 Kasım: "deployun böyle gitmesi normal mi" —
# /bulmaca 502). Tek birimde `systemctl restart` eski süreci kapatıp yenisini
# açıyordu; arada Caddy'nin arkasında dinleyen yoktu ve her deploy birkaç
# saniyelik bir 502 penceresi bırakıyordu. Şimdi yeni sürüm boştaki portta
# ayağa kalkıyor, sağlık kontrolünü geçince eski kapanıyor.
#
# Kurulum: deploy/bluegreen-setup.sh (root, idempotent; deploy iş akışı
# her koşuda çalıştırır, kuruluysa hiçbir şey yapmaz). Eski tek birim
# (`acilis-zili.service`) geçişte durdurulup devre dışı bırakılır; dosyası
# bootstrap ve geri dönüş için depoda kalır.
#
# Aşağısı eski birimin aynısı; tek farklar Description ve ExecStart'taki
# `-p %i`. Gerekçeler (neden `next start`, neden doğrudan `node`,
# sertleştirme) eski birimin başında: deploy/acilis-zili.service.

[Unit]
Description=Acilis Zili - Next.js uretim sunucusu (port %i)
Documentation=https://github.com/ahmetakyapi/acilis-zili
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=acilis
Group=acilis
# `current`, releases/<sürüm> dizinlerinden birine bağ (bkz. update.sh).
# Yeniden başlatmada yeniden çözülür; servis her zaman bağın o anki
# hedefinden çalışır.
WorkingDirectory=/srv/acilis-zili/current

# Secret'lar DEPONUN İÇİNDE DEĞİL. Depo herkese açık ve `git pull` ile
# güncelleniyor; anahtarların çalışma dizininde durması onları bir yanlış
# `git add`e bir tuş uzaklıkta bırakır. Dosya root:acilis 0640 olmalı.
EnvironmentFile=/etc/acilis-zili.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1

# YALNIZCA LOOPBACK. Dışarıya açılan tek şey Caddy; 3000 portu doğrudan
# internete bakarsa TLS'siz ve `X-Forwarded-For`suz bir ikinci kapı olur
# (giriş sayacı o başlığı okuyor — auth.ts).
ExecStart=/usr/bin/node /srv/acilis-zili/current/node_modules/next/dist/bin/next start -H 127.0.0.1 -p %i

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Sertleştirme: işletim sistemi salt-okunur, yalnızca uygulama kökü
# yazılabilir. `.next` yazılabilir KALMALI — ISR önbelleği ve
# `revalidatePath` oraya yazıyor, salt-okunur bir kökte yeniden doğrulama
# sessizce başarısız olur. Yol, bağ üzerinden değil kökten veriliyor:
# `current` her sürümde başka bir dizine döner, kök sabit.
#
# Paylaşılan veri önbelleği de kökün altında (`shared/fetch-cache`, bkz.
# update.sh — 20 Ekim); yazma izni `current/.next`e daraltılırsa o bağın
# hedefi salt-okunur kalır ve önbellek sessizce yazılamaz.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/acilis-zili

# Ucuz kapılar (20 Ekim taraması): Node sürecini ele geçiren birinin ad
# alanı açmasını, ham aygıta, çekirdek modülüne/günlüğüne, saate dokunmasını
# keser. Hiçbiri uygulamanın kullandığı bir şeyi kapatmıyor: ad alanı
# açılmıyor, aygıt olarak yalnız /dev/null ve /dev/urandom gerekiyor
# (PrivateDevices ikisini de veriyor), ağda TCP + yerel soket + arayüz
# listesi (AF_NETLINK, os.networkInterfaces) var. 3000 ayrıcalıksız bir
# port, yetki kümesi bu yüzden boş. Bilerek EKLENMEYEN: MemoryDenyWriteExecute
# — V8'in JIT'i ve WASM (OG kartlarının resvg'si) yazılabilir+çalıştırılabilir
# bellek istiyor, Node o kapıyla çalışmaz. Birim elle yeniden kurulmadan
# hiçbiri etkili olmaz (komut en üstte).
ProtectProc=invisible
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=acilis-zili

[Install]
WantedBy=multi-user.target
