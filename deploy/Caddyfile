# Açılış Zili — Caddy ters vekil yapılandırması
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   # alan adını düzenle, sonra:
#   sudo systemctl reload caddy
#
# NEDEN Caddy, nginx DEĞİL: TLS sertifikası otomatik alınıyor ve otomatik
# yenileniyor. nginx + certbot aynı işi yapar ama iki ayrı parça, iki ayrı
# zamanlayıcı ve yenileme unutulduğunda site sessizce kapanır.
#
# GÜVENLİK BAŞLIKLARI BURADA DEĞİL. Hepsi `next.config.ts` içinde ve tek
# kaynak orası olmalı; burada ikinci bir kopya tutmak ikisinin ayrı düşmesini
# bekletmekten başka bir şey değil. HSTS'i de Next basıyor.
#
# TEK KANONİK ADRES. `www.` alt alanı gerçek içerik SUNMUYOR, apex'e kalıcı
# (301) yönlendiriyor — aksi hâlde aynı içerik iki adreste durur ve arama
# motoru hangisinin asıl olduğuna kendi karar verir (`NEXT_PUBLIC_SITE_URL`,
# canonical etiketleri ve site haritası zaten yalnızca apex'i biliyor).

www.acilis-zili.ornek.com {
	redir https://acilis-zili.ornek.com{uri} permanent
}

acilis-zili.ornek.com {
	# TEK sıkıştırma katmanı: Next'te `compress: false` (20 Ekim, gerekçe
	# next.config.ts). Bu satır kalkarsa site sıkıştırmasız gider.
	encode zstd gzip

	# GÖVDE TAVANI (20 Ekim taraması). Caddy varsayılanda gövdeyi sınırsız
	# akıtıyor ve Next route handler'larında gövde sınırı yok; parçalı
	# (`chunked`) ya da HTTP/2 gövdesi `Content-Length` taşımadığı için
	# uçlardaki başlık denetimini de atlıyordu. Uçlar artık okurken sayıyor
	# (lib/read-body.ts); bu, Auth.js'in form POST'u gibi o yardımcıdan
	# geçmeyen yolları da kapsayan ikinci kat — `max_size` uzunluksuz gövdeyi
	# de keser. 5 MB en büyük meşru yükün çok üstünde: Bearer içerik uçlarının
	# (/api/mercek, /api/analiz, /api/brief) gövdesi en fazla ~200 KB, sunucu
	# eylemleri Next'te zaten 1 MB'ta kesiliyor; portföy ve vergi içe aktarma
	# dosyayı tarayıcıda okuyor, sunucuya dosya yüklenen yol yok.
	request_body {
		max_size 5MB
	}

	# Caddy `X-Forwarded-For`, `X-Forwarded-Proto` ve `X-Forwarded-Host`
	# başlıklarını kendiliğinden ekliyor. İlki giriş kaba kuvvet sayacının
	# anahtarı (auth.ts → signInKey), ikincisi Auth.js'in çerezi `Secure`
	# işaretlemesi için gerekli.
	# MAVİ-YEŞİL (11 Kasım): iki upstream, her an biri ayakta (deploy
	# sırasında birkaç saniye ikisi). `first`: sağlıklı olan ilki; aktif
	# yoklama (`/api/health/live`, iki saniyede bir, iki başarıyla sağlıklı)
	# yeni açılan portu ancak cevap verince devreye alıyor, kapanan portu bir
	# yoklamada düşürüyor. Arada kapanan porta giden istek 15 saniyeye kadar
	# ötekine yeniden denenir (`lb_try_*`). Tek birimde her deploy birkaç
	# saniyelik 502 bırakıyordu (sahibinin sorusu, 11 Kasım). Canlı sunucuda bu
	# blok deploy/bluegreen-setup.sh ile yerinde kurulur; bu dosya ilk kurulum
	# (bootstrap.sh) için.
	reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
		lb_policy first
		lb_try_duration 15s
		lb_try_interval 250ms
		health_uri /api/health/live
		health_interval 2s
		health_timeout 2s
		health_passes 2
		health_fails 1
		# Gün akışı ucu 30 saniyede bir yoklanıyor; cron ucu ise 100 saniye
		# bütçeli. Varsayılan vekil zaman aşımı ikincisini keserdi.
		transport http {
			response_header_timeout 180s
		}
	}
}
