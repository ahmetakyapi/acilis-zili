# Açılış Zili — ortam değişkenleri
#
# Kopyala:  cp .env.example .env.local
# Bu dosyaya ASLA gerçek değer yazma; .env.local gitignore'da, bu dosya değil.
#
# Hiçbiri olmadan da uygulama açılır: veri kartları "veri alınamadı" gösterir,
# sayfa çökmez. Anahtarların çalıştığını doğrulamak için (yalnızca geliştirme):
#   http://localhost:3000/api/debug/providers

# ---- Zorunlu ----------------------------------------------------------------

# Neon PostgreSQL bağlantı adresi — neon.tech → yeni proje → connection string.
# Yoksa: takvim, haber, bülten ve favoriler boş; fiyatlar yine gelir.
DATABASE_URL=

# Auth.js oturum imzalama anahtarı.  Üret:  openssl rand -base64 32
AUTH_SECRET=

# ---- Veri sağlayıcıları (hepsinin ücretsiz katmanı yeterli) ------------------

# alpaca.markets → hesap → API Keys. Paper hesap yeterli.
# Fiyat ve grafik barları. Ücretsiz katman konsolide tape'i (SIP) 15 dakika
# gecikmeli veriyor; ekranda damgalanır. Bir dönem IEX kullanıldı ve bırakıldı —
# gerçek zamanlıydı ama hacmin küçük bir kısmını görüyordu (gerekçe
# lib/providers/alpaca.ts başında).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# finnhub.io → Get free API key.  Dakikada 60 istek.
# Şirket profili, bilanço takvimi, halka arz takvimi, haberler, metrikler.
FINNHUB_API_KEY=

# fred.stlouisfed.org/docs/api/api_key.html
# Makro göstergeler, tahvil faizleri ve VIX.
FRED_API_KEY=

# USD/TRY kuru TCMB'nin açık bülteninden gelir — anahtar gerekmez. Geçmiş
# günlerin kuru TCMB arşivinden, uzun aralıkların aylık ortalaması FRED'den
# (CCUSMA02TRM618N, yukarıdaki FRED_API_KEY ile) gelir.

# ---- Cron ve ajan uçları ----------------------------------------------------
#
# İkisi de üretimde ZORUNLU: tanımlı değilse ilgili uç 503 döner.
# Kasıtlı — anahtarsız bir cron ucu, sağlayıcı kotasını harcayan ve
# veritabanına yazan herkese açık bir kapıdır.

# Günlük senkron ucunu (/api/cron/daily) korur.  Üret:  openssl rand -hex 32
# Vercel Cron bunu "Authorization: Bearer" başlığıyla kendisi gönderir.
CRON_SECRET=

# Bülten ve mercek uçlarını korur (/api/brief, /api/mercek ve context'leri).
# Kendi Claude rutinin bu anahtarla yazı gönderir.  Üret:  openssl rand -hex 32
BRIEF_SECRET=

# ---- Opsiyonel --------------------------------------------------------------

# Günlük özeti Claude yazsın istiyorsan. Yoksa kural tabanlı özet üretilir.
# Haber çevirisinde de DEEPL_API_KEY yoksa yedek olarak bu kullanılır.
ANTHROPIC_API_KEY=

# Haber başlıklarını Türkçeye çevirir. Ücretsiz katman ayda 500K karakter.
# Öncelik sırası: DEEPL_API_KEY → ANTHROPIC_API_KEY → çeviri atlanır.
DEEPL_API_KEY=

# Üretim adresi — sitemap, robots ve OG etiketleri bunu okur.
# Vercel'de tanımlı değilse VERCEL_PROJECT_PRODUCTION_URL'e düşer; Vercel
# DIŞINDA o yedek yok, yani orada bu değişken ZORUNLU. Verilmezse site
# haritası localhost adresleri yayınlar — sessiz ama pahalı bir hata.
NEXT_PUBLIC_SITE_URL=

# OpenFIGI (openfigi.com → API Key) — ünlü yatırımcıların 13F satırlarındaki
# CUSIP'i borsa sembolüne çevirir. Anahtarsız da çalışır: dakikada 25 istek,
# istek başına 10 CUSIP. Anahtarla istek başına 100 CUSIP; sezonda yeni
# pozisyonların logosu ve bağlantısı aynı gün gelir.
OPENFIGI_API_KEY=
# SEC EDGAR istek kimliği: "KurumAdı iletişim@adres". Boşsa koddaki
# varsayılan kullanılır (lib/investors.ts → secUserAgent).
SEC_USER_AGENT=

# ---- Vercel dışında barındırma (bkz. docs/deploy-vps.md) --------------------
#
# İkisi de Vercel'de GEREKSİZ: orada Auth.js barındırmayı kendisi tanıyor ve
# indekslenebilirlik VERCEL_ENV'den okunuyor.

# Auth.js üretimde Host başlığına varsayılan olarak güvenmez. Ters vekil
# (Caddy/nginx) arkasında bu "true" olmazsa giriş yönlendirmeleri yanlış
# adrese gider. Değeri Vercel'de bırakma.
AUTH_TRUST_HOST=

# Bu kopya arama motorlarına açık mı. Boşsa eski davranış: önizleme dışında
# her yer indekslenebilir. Site İKİ YERDE birden canlıysa ikincil kopyada
# "false" olmalı — aynı içeriğin iki adresi kopya içerik sayılır.
# DERLEME ZAMANINDA okunur (robots.ts ve sitemap.ts statik üretiliyor),
# yani `npm run build` öncesinde ortamda olmalı.
SITE_INDEXABLE=

# Ziyaretçi özetinin tuzu. Tanımlı değilse AUTH_SECRET kullanılır — yani
# ölçüm ayrı bir sır gerektirmiyor, bu değişken yalnızca ölçüm tuzunu
# oturum sırrından AYIRMAK isteyen kurulum için. Yerelde ikisi de boşsa
# sabit bir geliştirme dizesi kullanılır (bkz. lib/analytics.ts).
ANALYTICS_SALT=

# TCMB EVDS (evds3.tcmb.gov.tr → üye ol → profil → API anahtarı).  Opsiyonel.
# TÜFE (Reel TL görünümü) ve Yİ-ÜFE (vergi hesaplayıcısında maliyet
# endekslemesi) buradan gelir. Yoksa Reel TL düğmesi hiç basılmaz ve vergi
# hesaplayıcısı Yİ-ÜFE değerlerini okuyucudan ister (lib/providers/evds.ts).
EVDS_API_KEY=

# SEC EDGAR kimlik başlığı — anlık bilanço bildirimi (lib/providers/sec-edgar.ts).
# SEC kurallarına göre "Ad e-posta" biçiminde iletişim bilgisi içermeli;
# boşsa site adresiyle genel bir başlık gider (bugün kabul ediliyor, SEC
# sıkılaştırırsa 403 döner ve akış sessizce Finnhub'ı beklemeye döner).
SEC_USER_AGENT=
